{
    "name": "@elliot-huffman/check-in",
    "description": "Checks the presented ID to see if it is a valid ID and records the entry/exit of the user.",
    "type": "module",
    "private": true,
    "license": "MIT",
    "author": {
        "name": "Elliot Huffman",
        "email": "elliot@huffman.me",
        "url": "https://elliot.huffman.me"
    },
    "workspaces": [
        "runtime",
        "user-interface"
    ],
    "allowScripts": {
        "electron-winstaller@5.4.0": true
    },
    "overrides": {
        "es-define-property": "npm:@socketregistry/es-define-property@^1",
        "es-set-tostringtag": "npm:@socketregistry/es-set-tostringtag@^1",
        "globalthis": "npm:@socketregistry/globalthis@^1",
        "hasown": "npm:@socketregistry/hasown@^1",
        "is-core-module": "npm:@socketregistry/is-core-module@^1",
        "is-interactive": "npm:@socketregistry/is-interactive@^1",
        "is-unicode-supported": "npm:@socketregistry/is-unicode-supported@^1",
        "isarray": "npm:@socketregistry/isarray@^1",
        "path-parse": "npm:@socketregistry/path-parse@^1",
        "safe-buffer": "npm:@socketregistry/safe-buffer@^1",
        "safer-buffer": "npm:@socketregistry/safer-buffer@^1",
        "side-channel": "npm:@socketregistry/side-channel@^1"
    }
}
